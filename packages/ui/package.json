{
  "name": "@techuiux/dga-ui",
  "version": "0.3.0",
  "description": "DGA Platforms Code components for React: local 1:1 Figma components plus @dev-dga/react re-exports, behind one import.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techuiux/dga-components.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/techuiux/dga-components/tree/main/packages/ui#readme",
  "keywords": [
    "dga",
    "design-system",
    "react",
    "figma",
    "saudi",
    "rtl"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "esbuild src/styles.css --bundle --minify --outfile=dist/styles.css && esbuild src/tokens.css --outfile=dist/tokens.css",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@dev-dga/css": "1.5.0",
    "@dev-dga/react": "1.5.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
